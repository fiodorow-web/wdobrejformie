# Skopiuj do .env.local (lokalnie) albo ustaw w panelu Vercela (produkcja).
# Bez tych zmiennych strona nadal działa — formularz kontaktowy zwróci wtedy
# komunikat z numerem telefonu zamiast wysyłać maila.

# --- Resend: wysyłka wiadomości z formularza ---
# https://resend.com/api-keys
# Wymaga zweryfikowanej domeny (rekordy SPF/DKIM w DNS wdobrejformie.net).
RESEND_API_KEY=

# Adres nadawcy. Musi należeć do domeny zweryfikowanej w Resend.
CONTACT_FROM_EMAIL="Formularz <formularz@wdobrejformie.net>"

# --- Cloudflare Turnstile: ochrona antyspamowa formularza ---
# Klientka używa już wtyczki simple-cloudflare-turnstile na obecnej stronie,
# więc klucze prawdopodobnie istnieją — wystarczy je przepisać.
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
